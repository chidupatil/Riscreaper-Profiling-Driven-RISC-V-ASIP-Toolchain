#!/usr/bin/env python3
"""
riscreaper -- command-line entry point for the RISC-V ASIP trimming
toolchain built across this project.

This is deliberately a THIN ORCHESTRATOR, not a reimplementation.
Every subcommand below just calls the existing, already-tested shell
scripts in tools/ (c_to_mem.sh, build_from_c_with_trimming.sh,
build_and_vivado_trimmed.sh, run_vivado.sh) and the trim summary
generator (gen_trim_summary.py) -- none of the actual trimming logic
lives here.

Expected project layout (this file lives at the project root):
    riscreaper
    tools/
        c_to_mem.sh
        build_from_c_with_trimming.sh
        build_and_vivado_trimmed.sh
        run_vivado.sh
        gen_trim_summary.py
        riscv_harvard.ld
        ...
    demo/
    generated/
"""
from __future__ import annotations

import argparse
import subprocess
import sys
from pathlib import Path

