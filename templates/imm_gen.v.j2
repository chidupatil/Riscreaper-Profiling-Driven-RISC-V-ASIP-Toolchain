`timescale 1ns / 1ps

module imm_gen (
    input      [31:0] instruction,
    output reg [31:0] imm_out
);

    wire [6:0] opcode;
    assign opcode = instruction[6:0];

    always @(*) begin
        case (opcode)

{% if has_i_type %}
            // I-type: addi, lw, jalr, and similar
            7'b0010011,
            7'b0000011,
            7'b1100111: begin
{% raw %}
                imm_out = {{20{instruction[31]}}, instruction[31:20]};
{% endraw %}
            end
{% endif %}

{% if has_s_type %}
            // S-type: sw, sb, sh
            7'b0100011: begin
{% raw %}
                imm_out = {{20{instruction[31]}}, instruction[31:25], instruction[11:7]};
{% endraw %}
            end
{% endif %}

{% if has_b_type %}
            // B-type: beq, bne, blt, bge, bltu, bgeu
            7'b1100011: begin
{% raw %}
                imm_out = {{19{instruction[31]}},
                           instruction[31],
                           instruction[7],
                           instruction[30:25],
                           instruction[11:8],
                           1'b0};
{% endraw %}
            end
{% endif %}

{% if has_u_type %}
            // U-type: lui, auipc
            7'b0110111,
            7'b0010111: begin
                imm_out = {instruction[31:12], 12'b0};
            end
{% endif %}

{% if has_j_type %}
            // J-type: jal
            7'b1101111: begin
{% raw %}
                imm_out = {{11{instruction[31]}},
                           instruction[31],
                           instruction[19:12],
                           instruction[20],
                           instruction[30:21],
                           1'b0};
{% endraw %}
            end
{% endif %}

            default: begin
                imm_out = 32'b0;
            end
        endcase
    end

endmodule
